{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    // Die Belegvorlagen sind in TSX geschrieben.
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    // Muss innerhalb von dist liegen, damit ein `rimraf dist` den
    // Inkrementell-Cache mit entfernt und der nächste Build vollständig emittiert.
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": "./",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "prisma"]
}
