# PostgreSQL (docker compose up -d postgres)
POSTGRES_USER=garagentor
POSTGRES_PASSWORD=garagentor
POSTGRES_DB=garagentor
POSTGRES_PORT=5432

# Von Prisma und der API verwendet
DATABASE_URL="postgresql://garagentor:garagentor@localhost:5432/garagentor?schema=public"

# API
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Vor dem Produktivbetrieb zwingend ersetzen (z. B. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=dev-access-secret-bitte-ersetzen
JWT_REFRESH_SECRET=dev-refresh-secret-bitte-ersetzen
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Dokumentenablage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Web
# Die API liegt in derselben Anwendung unter /api – es gibt keine zweite
# Adresse mehr, die gesetzt werden müsste.

# Postausgang. Ohne MAIL_HOST läuft die Anwendung, verschickt aber nichts.
# In der Entwicklung genügt ein lokaler Auffangserver, etwa MailHog auf 1025.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_BCC=
