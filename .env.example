# Vorlage für die Entwicklung – kopieren nach .env.
#
#   cp .env.example .env
#
# Prisma, Docker Compose und die Anwendung lesen dieselbe Datei; sie liegt
# bewusst nur im Wurzelverzeichnis.

# PostgreSQL für die Entwicklung (npm run db:up).
# Im Produktivbetrieb übernimmt Supabase – siehe docs/betrieb.md.
POSTGRES_USER=garagentor
POSTGRES_PASSWORD=garagentor
POSTGRES_DB=garagentor
POSTGRES_PORT=5432

# Die Verbindung, über die der laufende Betrieb geht.
DATABASE_URL="postgresql://garagentor:garagentor@localhost:5432/garagentor?schema=public"

# Nur für `prisma migrate`. Lokal derselbe Wert wie oben; bei Supabase ist es
# die direkte Verbindung auf Port 5432, während DATABASE_URL über den Pooler
# auf Port 6543 läuft.
DIRECT_URL="postgresql://garagentor:garagentor@localhost:5432/garagentor?schema=public"

NODE_ENV=development

# Vor dem Produktivbetrieb zwingend ersetzen (z. B. `openssl rand -base64 48`).
# Die Anwendung weigert sich sonst zu starten.
JWT_ACCESS_SECRET=dev-access-secret-bitte-ersetzen
JWT_REFRESH_SECRET=dev-refresh-secret-bitte-ersetzen
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Dokumentenablage: ein privater Bucket in Supabase Storage. Ohne SUPABASE_URL
# und Dienstschlüssel läuft alles außer dem Hoch- und Herunterladen von Dateien.
# Der Dienstschlüssel umgeht RLS und darf den Browser nie erreichen.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dokumente
MAX_UPLOAD_MB=25

# Weist den nächtlichen Aufruf von POST /api/cron aus. In der Entwicklung
# optional; ohne den Wert lehnt der Endpunkt jeden Aufruf ab.
CRON_SECRET=

# Die Oberfläche spricht die Schnittstelle unter /api derselben Anwendung an –
# es gibt keine zweite Adresse mehr, die gesetzt werden müsste.

# Postausgang. Ohne MAIL_HOST läuft die Anwendung, verschickt aber nichts.
# In der Entwicklung genügt ein lokaler Auffangserver, etwa MailHog auf 1025.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_BCC=
