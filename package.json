{
  "name": "garagentor",
  "version": "0.1.0",
  "private": true,
  "description": "Branchensoftware f\u00fcr Garagentor-Fachbetriebe (Handwerk)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace @garagentor/shared",
    "dev": "npm run build:shared && concurrently -k -n shared,web -c blue,magenta npm:dev:shared npm:dev:web",
    "dev:shared": "npm run dev --workspace @garagentor/shared",
    "dev:web": "npm run dev --workspace @garagentor/web",
    "setup": "npm run build:shared && npm run db:generate && npm run db:migrate && npm run db:seed",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @garagentor/web",
    "db:migrate": "npm run db:migrate --workspace @garagentor/web",
    "db:seed": "npm run db:seed --workspace @garagentor/web",
    "db:studio": "npm run db:studio --workspace @garagentor/web",
    "paket": "bash tools/hostinger-paket.sh"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
