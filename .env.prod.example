# Vorlage für den Produktivbetrieb – kopieren nach .env.prod und ausfüllen.
# Die Datei enthält Zugangsdaten und gehört nicht ins Repository.
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod

# Domain, unter der die Anwendung erreichbar ist (ohne https://).
# Muss per DNS auf diesen Server zeigen, sonst schlägt die Zertifikatsausstellung fehl.
DOMAIN=garagentor.example.de

# Adresse für Ablaufwarnungen von Let's Encrypt.
ACME_EMAIL=technik@example.de

# Datenbank. Das Passwort wird nur intern zwischen den Containern verwendet.
POSTGRES_USER=garagentor
POSTGRES_PASSWORD=
POSTGRES_DB=garagentor

# Je 48 Byte Zufall, getrennt erzeugen:
#   openssl rand -base64 48
# Ein Wechsel des Refresh-Secrets meldet alle Benutzer ab.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Obergrenze je hochgeladener Datei.
MAX_UPLOAD_MB=25
