# Checkliste für den Produktivbetrieb.
#
# Diese Werte gehören bei Hostinger in hPanel unter „Node.js" als
# Umgebungsvariablen – **nicht** als Datei ins hochgeladene Paket. Die Liste
# hier ist eine Abschrift zum Abhaken, keine Datei, die irgendwo gelesen wird.
#
# Ausführlich beschrieben in docs/betrieb.md.

# --- Datenbank (Supabase, Frankfurt) ----------------------------------------
# Beide Adressen stehen im Supabase-Dashboard unter
# Project Settings → Database → Connection string.

# Der Pooler (Supavisor), Transaction mode, Port 6543. Die zwei Parameter
# gehören zwingend dran: pgbouncer=true schaltet Prismas vorbereitete
# Anweisungen ab, connection_limit=1 verhindert, dass mehrere Node-Prozesse
# das Verbindungskontingent aufbrauchen.
DATABASE_URL=

# Die direkte Verbindung, Port 5432. Ausschließlich für `prisma migrate` –
# Migrationen brauchen Sperren, die der Pooler nicht durchreicht.
DIRECT_URL=

# Optional, empfohlen: das Wurzelzertifikat von Supabase, zu finden unter
# Project Settings → Database → SSL Configuration. Zeilenumbrüche dürfen als
# \n geschrieben werden, weil hPanel kein mehrzeiliges Feld anbietet.
#
# Die Verbindung ist auch ohne diesen Wert verschlüsselt – dann bleibt aber
# ungeprüft, ob am anderen Ende wirklich Supabase antwortet.
DATABASE_SSL_CA=

# Optional: Wie viele Datenbankverbindungen ein Node-Prozess offen hält.
# Voreinstellung 5. Höher zu gehen lohnt erst mit einem größeren Supabase-Tarif.
DATABASE_POOL_MAX=

# --- Sitzungen ---------------------------------------------------------------
# Je 48 Byte Zufall, getrennt erzeugen:
#   openssl rand -base64 48
# Kürzer als 32 Zeichen lehnt die Anwendung ab. Ein Wechsel des
# Refresh-Secrets meldet alle Benutzer ab.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Dokumentenablage (Supabase Storage) ------------------------------------
SUPABASE_URL=https://kcrozoxqjlwgofbtrkgr.supabase.co
# Project Settings → API → service_role. Umgeht RLS und darf den Browser nie
# erreichen; er wird ausschließlich serverseitig gelesen.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dokumente
MAX_UPLOAD_MB=25

# --- Nächtlicher Lauf --------------------------------------------------------
# Damit weist sich der Cron-Job gegenüber POST /api/cron aus.
#   openssl rand -base64 48
CRON_SECRET=

# --- Postausgang -------------------------------------------------------------
# Port 465 spricht von Anfang an TLS, Port 587 beginnt offen und wechselt per
# STARTTLS – MAIL_SECURE gehört dazu. Damit die Mails nicht im Spam landen,
# gehören SPF, DKIM und DMARC beim Domainanbieter eingerichtet; das kann die
# Anwendung nicht für Sie tun.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
# Absenderadresse; muss beim Anbieter freigeschaltet sein.
MAIL_FROM=
MAIL_REPLY_TO=
# Stille Kopie in den eigenen Posteingang, fürs Archiv.
MAIL_BCC=
